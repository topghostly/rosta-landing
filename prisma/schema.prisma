generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URI")
}

enum AgencyRole {
  FOUNDER
  DIRECTOR
  ACCOUNT_MANAGER
  OPERATIONS
  OTHER
}

enum TeamSize {
  SOLO
  SMALL
  MID
  LARGE
}

model WaitlistEntry {
  id          String     @id @default(cuid())
  fullName    String
  email       String     @unique
  agencyName  String
  role        AgencyRole
  country     String
  teamSize    TeamSize
  createdAt   DateTime   @default(now())

  @@index([createdAt])
}
